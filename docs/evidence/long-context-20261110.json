      "implementation": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENT = Decimal(\"0.01\")\n\n\ndef summarize(rows):\n    groups = {}\n    for row in rows:\n        sku = row[\"sku\"]\n        quantity = row[\"quantity\"]\n        price = Decimal(str(row[\"unit_price\"]))\n        group = groups.get(sku)\n        if group is None:\n            group = groups[sku] = {\"units\": 0, \"total\": Decimal(\"0\")}\n        group[\"units\"] += quantity\n        group[\"total\"] += quantity * price\n\n    summary = []\n    for sku, group in groups.items():\n        if group[\"units\"] == 0:\n            continue\n        total = group[\"total\"].quantize(_CENT, rounding=ROUND_HALF_UP)\n        summary.append({\"sku\": sku, \"units\": group[\"units\"], \"total\": str(total)})\n    return summary\n",
