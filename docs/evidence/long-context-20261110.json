      "implementation": "\"\"\"Summarize invoice rows per SKU.\n\nRules:\n- SKUs are canonicalized with Unicode NFC then casefold; equal canonical\n  SKUs are merged and the output is sorted by canonical SKU.\n- Each row subtotal is quantized to cents with ROUND_HALF_UP before summing.\n- Negative quantity or negative unit price raises ValueError.\n- Zero-quantity rows contribute nothing; the input is never mutated.\n\"\"\"\n\nimport unicodedata\nfrom decimal import Decimal, ROUND_HALF_UP\n\n_CENT = Decimal(\"0.01\")\n\n\ndef _canonical_sku(sku):\n    return unicodedata.normalize(\"NFC\", sku).casefold()\n\n\ndef summarize(rows):\n    totals = {}\n    units = {}\n\n    for row in rows:\n        quantity = row[\"quantity\"]\n        unit_price = Decimal(row[\"unit_price\"])\n\n        if quantity < 0:\n            raise ValueError(\"negative quantity: %r\" % (quantity,))\n        if unit_price < 0:\n            raise ValueError(\"negative unit_price: %r\" % (row[\"unit_price\"],))\n\n        if quantity == 0:\n            continue\n\n        key = _canonical_sku(row[\"sku\"])\n        subtotal = (Decimal(quantity) * unit_price).quantize(\n            _CENT, rounding=ROUND_HALF_UP\n        )\n        totals[key] = totals.get(key, Decimal(\"0.00\")) + subtotal\n        units[key] = units.get(key, 0) + quantity\n\n    return [\n        {\n            \"sku\": key,\n            \"units\": units[key],\n            \"total\": str(totals[key].quantize(_CENT, rounding=ROUND_HALF_UP)),\n        }\n        for key in sorted(totals)\n    ]\n",
