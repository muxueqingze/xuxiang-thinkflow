      "implementation": "import unicodedata\nfrom decimal import Decimal, ROUND_HALF_UP\n\nCENTS = Decimal(\"0.01\")\n\n\ndef _canonical_sku(sku):\n    return unicodedata.normalize(\"NFC\", sku).casefold()\n\n\ndef summarize(rows):\n    groups = {}\n    for row in rows:\n        sku = _canonical_sku(row[\"sku\"])\n        quantity = row[\"quantity\"]\n        unit_price = Decimal(row[\"unit_price\"])\n        if quantity < 0 or unit_price < 0:\n            raise ValueError(\"negative quantity or unit_price\")\n        if quantity == 0:\n            continue\n        subtotal = (Decimal(quantity) * unit_price).quantize(\n            CENTS, rounding=ROUND_HALF_UP\n        )\n        group = groups.get(sku)\n        if group is None:\n            groups[sku] = [quantity, subtotal]\n        else:\n            group[0] += quantity\n            group[1] += subtotal\n\n    result = []\n    for sku in sorted(groups):\n        units, total = groups[sku]\n        if units == 0:\n            continue\n        total = total.quantize(CENTS, rounding=ROUND_HALF_UP)\n        text = format(total, \".2f\")\n        if text == \"-0.00\":\n            text = \"0.00\"\n        result.append({\"sku\": sku, \"units\": units, \"total\": text})\n    return result\n",
