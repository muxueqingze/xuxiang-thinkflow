      "implementation": "from decimal import Decimal, ROUND_HALF_UP\n\n_CENTS = Decimal(\"0.01\")\n\n\ndef summarize(rows):\n    \"\"\"Aggregate invoice rows by SKU.\n\n    Rows carry ``sku``, ``quantity`` and a decimal ``unit_price`` string.\n    The result lists one entry per SKU in first-appearance order with the\n    summed ``units`` and the summed line total formatted as \"0.00\".\n    \"\"\"\n    totals = {}\n    units = {}\n    order = []\n    for row in rows:\n        sku = row[\"sku\"]\n        quantity = row[\"quantity\"]\n        if sku not in totals:\n            order.append(sku)\n            totals[sku] = Decimal(\"0\")\n            units[sku] = 0\n        totals[sku] += Decimal(str(row[\"unit_price\"])) * quantity\n        units[sku] += quantity\n    return [\n        {\n            \"sku\": sku,\n            \"units\": units[sku],\n            \"total\": str(totals[sku].quantize(_CENTS, rounding=ROUND_HALF_UP)),\n        }\n        for sku in order\n    ]\n",
